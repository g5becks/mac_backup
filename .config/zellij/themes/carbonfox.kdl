themes {
    carbonfox {
        // Text components
        text_unselected {
            base 242 244 248      // foreground #f2f4f8
            background 22 22 22   // background #161616
            emphasis_0 120 169 255 // blue #78a9ff
            emphasis_1 82 189 255  // cyan #52bdff
            emphasis_2 70 201 128  // green #46c880
            emphasis_3 190 149 255 // purple #be95ff
        }
        text_selected {
            base 242 244 248      // foreground #f2f4f8
            background 42 42 42   // selection-background #2a2a2a
            emphasis_0 120 169 255 // blue #78a9ff
            emphasis_1 82 189 255  // cyan #52bdff
            emphasis_2 70 201 128  // green #46c880
            emphasis_3 190 149 255 // purple #be95ff
        }
        
        // Ribbon components (tabs and mode indicators)
        ribbon_unselected {
            base 223 223 224      // palette 7 #dfdfe0
            background 40 40 40   // slightly lighter than bg #282828
            emphasis_0 120 169 255 // blue #78a9ff
            emphasis_1 82 189 255  // cyan #52bdff
            emphasis_2 70 201 128  // green #46c880
            emphasis_3 190 149 255 // purple #be95ff
        }
        ribbon_selected {
            base 22 22 22         // background color for text
            background 120 169 255 // blue #78a9ff for active tab
            emphasis_0 242 244 248 // foreground #f2f4f8
            emphasis_1 82 189 255  // cyan #52bdff
            emphasis_2 70 201 128  // green #46c880
            emphasis_3 190 149 255 // purple #be95ff
        }
        
        // Table components
        table_title {
            base 120 169 255      // blue #78a9ff
            background 22 22 22   // background #161616
            emphasis_0 242 244 248 // foreground #f2f4f8
            emphasis_1 82 189 255  // cyan #52bdff
            emphasis_2 70 201 128  // green #46c880
            emphasis_3 190 149 255 // purple #be95ff
        }
        table_cell_unselected {
            base 242 244 248      // foreground #f2f4f8
            background 22 22 22   // background #161616
            emphasis_0 120 169 255 // blue #78a9ff
            emphasis_1 82 189 255  // cyan #52bdff
            emphasis_2 70 201 128  // green #46c880
            emphasis_3 190 149 255 // purple #be95ff
        }
        table_cell_selected {
            base 242 244 248      // foreground #f2f4f8
            background 42 42 42   // selection-background #2a2a2a
            emphasis_0 120 169 255 // blue #78a9ff
            emphasis_1 82 189 255  // cyan #52bdff
            emphasis_2 70 201 128  // green #46c880
            emphasis_3 190 149 255 // purple #be95ff
        }
        
        // List components
        list_unselected {
            base 242 244 248      // foreground #f2f4f8
            background 22 22 22   // background #161616
            emphasis_0 120 169 255 // blue #78a9ff
            emphasis_1 82 189 255  // cyan #52bdff
            emphasis_2 70 201 128  // green #46c880
            emphasis_3 190 149 255 // purple #be95ff
        }
        list_selected {
            base 242 244 248      // foreground #f2f4f8
            background 42 42 42   // selection-background #2a2a2a
            emphasis_0 120 169 255 // blue #78a9ff
            emphasis_1 82 189 255  // cyan #52bdff
            emphasis_2 70 201 128  // green #46c880
            emphasis_3 190 149 255 // purple #be95ff
        }
        
        // Frame components (pane borders)
        frame_unselected {
            base 72 72 72         // palette 8 #484848
            background 22 22 22   // background #161616
            emphasis_0 120 169 255 // blue #78a9ff
            emphasis_1 82 189 255  // cyan #52bdff
            emphasis_2 70 201 128  // green #46c880
            emphasis_3 190 149 255 // purple #be95ff
        }
        frame_selected {
            base 120 169 255      // blue #78a9ff for active pane
            background 22 22 22   // background #161616
            emphasis_0 242 244 248 // foreground #f2f4f8
            emphasis_1 82 189 255  // cyan #52bdff
            emphasis_2 70 201 128  // green #46c880
            emphasis_3 190 149 255 // purple #be95ff
        }
        frame_highlight {
            base 190 149 255      // purple #be95ff for mode highlight
            background 22 22 22   // background #161616
            emphasis_0 242 244 248 // foreground #f2f4f8
            emphasis_1 120 169 255 // blue #78a9ff
            emphasis_2 70 201 128  // green #46c880
            emphasis_3 82 189 255  // cyan #52bdff
        }
        
        // Exit code indicators
        exit_code_success {
            base 70 201 128       // green #46c880
            background 22 22 22   // background #161616
            emphasis_0 242 244 248 // foreground #f2f4f8
            emphasis_1 120 169 255 // blue #78a9ff
            emphasis_2 82 189 255  // cyan #52bdff
            emphasis_3 190 149 255 // purple #be95ff
        }
        exit_code_error {
            base 238 83 150       // pink/red #ee5396
            background 22 22 22   // background #161616
            emphasis_0 242 244 248 // foreground #f2f4f8
            emphasis_1 120 169 255 // blue #78a9ff
            emphasis_2 82 189 255  // cyan #52bdff
            emphasis_3 190 149 255 // purple #be95ff
        }
        
        // Multiplayer user colors
        multiplayer_user_colors {
            player_1 120 169 255  // blue #78a9ff
            player_2 82 189 255   // cyan #52bdff
            player_3 70 201 128   // green #46c880
            player_4 190 149 255  // purple #be95ff
            player_5 238 83 150   // pink #ee5396
            player_6 45 189 186   // teal #2dc7c4
            player_7 241 109 166  // lighter pink #f16da6
            player_8 140 182 255  // lighter blue #8cb6ff
            player_9 200 165 255  // lighter purple #c8a5ff
            player_10 37 190 106  // darker green #25be6a
        }
    }
}
