layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    
    // Main terminal - always ready
    tab name="terminal" focus=true {
        pane {
            cwd "."
        }
    }
    
    // AI assistants
    tab name="claude" {
        pane command="claude" {
            cwd "."
            start_suspended true
            close_on_exit true
        }
    }
    
    tab name="glm" {
        pane command="glm" {
            cwd "."
            start_suspended true
            close_on_exit true
        }
    }
    
    tab name="copilot" {
        pane command="copilot" {
            cwd "."
            start_suspended true
            close_on_exit true
        }
    }

    tab name="gemini" {
        pane command="gemini" {
            cwd "."
            start_suspended true
            close_on_exit true
        }
    }
    
    tab name="amazon q" {
        pane command="q" {
            cwd "."
            start_suspended true
            close_on_exit true
        }
    }

    tab name="qwen" {
    	pane command="qwen" {
    		cwd "."
    		start_suspended true
    		close_on_exit true
    	}
    }

    
    tab name="amp" {
    	pane command="amp" {
    		cwd "."
    		start_suspended true
    		close_on_exit true
    	}
    }
}
