// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "auto_update_extensions": {
    "ts-macro": false
  },
  "soft_wrap": "editor_width",
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 23.0
  },
  "use_system_window_tabs": true,
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true,
    "enable_preview_multibuffer_from_code_navigation": true,
    "enable_preview_from_file_finder": true
  },
  "tabs": {
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true
  },
  "title_bar": {
    "show_menus": true,
    "show_branch_icon": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "which_key": {
    "enabled": true
  },
  "ui_font_weight": 500.0,
  "agent": {
    "dock": "right",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "oswe-vscode-prime"
    },
    "always_allow_tool_actions": true,
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o"
    },
    "model_parameters": []
  },
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "settings": {}
    },
    "mcp-server-brave-search": {
      "enabled": true,
      "settings": {}
    },
    "mcp-server-exa-search": {
      "enabled": false,
      "settings": {}
    },
    "mcp-server-context7": {
      "enabled": true,
      "settings": {}
    },
    "bun-docs-mcp": {
      "enabled": true,
      "settings": {}
    }
  },
  "always_treat_brackets_as_autoclosed": true,
  "colorize_brackets": true,
  "agent_ui_font_size": 14.0,
  "ui_font_family": "Cartograph CF",
  "buffer_font_family": "Cartograph CF",
  "theme_overrides": {
    "Oxocarbon Dark (Variant I)": {
      "accents": ["#00B448", "#00B4A1", "#006CB4", "#B4006C", "#B44800"],
      "syntax": {
        "comment": {
          "font_style": "italic"
        },
        "comment.doc": {
          "font_style": "italic"
        },
        "keyword": {
          "font_style": "italic"
        }
      }
    }
  },
  "languages": {
    "FSharp": {
      "indent_guides": {
        "enabled": false,
        "background_coloring": "indent_aware",
        "coloring": "indent_aware"
      },
      "soft_wrap": "preferred_line_length"
    },
    "CSharp": {
      "soft_wrap": "prefer_line"
    }
  },
  "lsp": {
    "omnisharp": {
      "binary": {
        "path": "csharp-language-server"
      }
    }
  },
  "helix_mode": true,
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 14.4,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Denix Theme"
  }
}
